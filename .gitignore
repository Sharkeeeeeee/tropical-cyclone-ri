# Data. Everything here is regenerated by the numbered scripts from public
# sources, and none of it belongs in git: raw/ is ~1.5 GB of downloads and
# processed/ holds multi-gigabyte patch memmaps.
data/

# Built for upload to a cloud runner; regenerate with make_colab_bundle.py.
colab_bundle.zip
*.zip

# Model checkpoints and out-of-fold predictions.
*.npy
*.npz
*.pt
*.pth
*.ckpt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Partial downloads
*.part
*.tmp

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local tooling state
.claude/

# Local secrets and credentials. Only sanitized environment examples belong in git.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519
.ssh/
.aws/
.netrc
_netrc
credentials.json
service-account*.json
